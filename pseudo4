class(Asset) #two- or three letter shorthand for asset class
#implemented in asset.py:
    def __init__(self, config):
        """Initialize asset with config dictionary.
        
        Args:
            config (dict): Configuration dictionary with input keys mapped to subscriptions.

                          output values are set based on config or default preset values. 
                          If output is a Series, it is initialized with the starting value from config or preset.
                          Subscriptions are tuples of (asset_id, output_key) representing
                          outputs from other assets to subscribe to.
        """
        # Merge with default preset if not fully specified
        merged_config = {**self.PRESETS.get("default", {}), **config}
        
        # Initialize input subscriptions
        for input_key in self.input:
            if input_key in merged_config:
                subscription = merged_config[input_key]
                # subscription should be (asset_id, output_key) tuple
                self.input[input_key] = subscription
            else: # throw error: missing input key in config
                raise ValueError(f"Missing input key '{input_key}' in config for asset '{self.__class__.__name__}' (not in default preset either)")
        # Initialize output values
        for output_key in self.output:
            if output_key in merged_config:
                value = merged_config[output_key]
                output_type = self.output[output_key][0]
                # If expecting Series, initialize with starting value
                if isinstance(output_type, type) and issubclass(output_type, Series):
                    self.output[output_key] = [Series(starting_value=value), self.output[output_key][1]]
                else:
                    self.output[output_key] = [value, self.output[output_key][1]]
            else:
                # Set default from preset if available
                if "output" in self.PRESETS.get("default", {}):
                    preset_output = self.PRESETS["default"]["output"].get(output_key)
                    if preset_output:
                        self.output[output_key] = [preset_output, self.output[output_key][1]]

    @classmethod
    def get_preset(key=None): #returns dict of preset name to config values
        if key:
            return self.PRESETS[key]
        else:
            return self.PRESETS
    @classmethod
    def get_input(key=None): #returns dict of input key to expected type or expected type for given key
        if key:
            return self.input[key]
        else:
            return self.input
    @classmethod
    def get_output(key=None): #returns dict of output key to expected type 
        if key:
            return self.output[key]
        else:
            return self.output
    @classmethod
    def get_dependency(key): #returns list of input keys required to calculate output key
        return self.output[key][1]
    
