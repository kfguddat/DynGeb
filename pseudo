core concepts:
	medium:
		heat, electricity, money
	asset:
		- has inputs/outputs per medium
		- has config data (yaml)
		- has state (time series)
		- each asset has its own file with functions to calculate hourly in/out
	pipe:
		- connects asset outputs to inputs
		- optional splitter with ratios or priorities

yaml config (single nested file):
	simulation:
		start: YYYY-MM-DD
		end: YYYY-MM-DD
		timestep_hours: 1
		weather_file: path.csv
	assets:
		pv:
			class: Photovoltaic
			params: { ... }
		bt:
			class: Battery
			params: { ... }
	pipes:
		- from: pv.electricity_out
		  to: bt.electricity_in
		  splitter: { type: ratio, values: [0.7, 0.3] }



simulation flow: (in simulation.py)
    load config yaml
    initialize assets
    load environment asset with external data (weather, import/export prices)
	initialize pipes
	for each hour:
        compute demand (inputs heat/electricity flow)
		compute supply (outputs heat/electricity flow)
        compute balance and grid interaction
        compute wallet (money flow)
		store results
	export csv results

gui:
	config editor:
		create/edit yaml
		validate asset connections
		save yaml
        optional: simulation run button
	analysis:
		load csv
		plot time series per medium
		compare assets and totals
